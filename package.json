{
  "name": "@scoretravel/takehome",
  "version": "0.0.1",
  "sideEffects": false,
  "engines": {
    "node": ">=20.15",
    "pnpm": "9.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest --run test",
    "test:watch": "vitest test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "env-cmd nodemon --watch src --watch .env src/index.ts"
  },
  "dependencies": {
    "@aws-lite/s3-types": "^0.2.6",
    "@aws-sdk/client-s3": "^3.734.0",
    "@aws-sdk/lib-storage": "^3.735.0",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "minio": "^8.0.4",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.18.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
